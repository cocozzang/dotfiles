font-family = CaskaydiaCove Nerd Font
font-size = 16

theme = catppuccin-mocha.conf

# Don't restore leftover Ghostty windows; tmux-restore opens one per session.
window-save-state = never
initial-command = /Users/coco/.config/ghostty/tmux-restore

gtk-titlebar = false
window-padding-x = 12
window-padding-y = 12

keybind = cmd+opt+h=goto_split:left
keybind = cmd+opt+j=goto_split:bottom
keybind = cmd+opt+k=goto_split:top
keybind = cmd+opt+l=goto_split:right

keybind = cmd+opt+v=new_split:right
keybind = cmd+opt+s=new_split:down

keybind = cmd+opt+shift+h=resize_split:left,50
keybind = cmd+opt+shift+j=resize_split:down,50
keybind = cmd+opt+shift+k=resize_split:up,50
keybind = cmd+opt+shift+l=resize_split:right,50

keybind = cmd+opt+x=close_surface

keybind = cmd+opt+z=toggle_split_zoom

#keybind = shift+enter=text:\n
# tmux extended-keys treats raw LF as Ctrl+J, and does not pass Shift on Enter.
# Send the same ESC+CR that Option+Enter already uses (Grok's newline fallback).
keybind = shift+enter=text:\x1b\r

# Ctrl+Shift+letter otherwise collapses to Ctrl+letter (C-h/C-l/C-d).
# Send xterm extended-key CSI so tmux can bind C-S-h/l/c.
# key_X is the physical key: Hangul IME makes ctrl+shift+l produce ㅣ,
# so a unicode `l` trigger never matches.
keybind = ctrl+shift+key_h=csi:27;6;104~
keybind = ctrl+shift+key_l=csi:27;6;108~
keybind = ctrl+shift+key_c=csi:27;6;99~

# Prefix (C-b) then a letter: intercept the physical key and send Latin
# to tmux, so prefix+c/n/p/... work while Hangul IME is on.
keybind = ctrl+key_b>key_a=text:\x02a
keybind = ctrl+key_b>key_b=text:\x02b
keybind = ctrl+key_b>key_c=text:\x02c
keybind = ctrl+key_b>key_d=text:\x02d
keybind = ctrl+key_b>key_e=text:\x02e
keybind = ctrl+key_b>key_f=text:\x02f
keybind = ctrl+key_b>key_g=text:\x02g
keybind = ctrl+key_b>key_h=text:\x02h
keybind = ctrl+key_b>key_i=text:\x02i
keybind = ctrl+key_b>key_j=text:\x02j
keybind = ctrl+key_b>key_k=text:\x02k
keybind = ctrl+key_b>key_l=text:\x02l
keybind = ctrl+key_b>key_m=text:\x02m
keybind = ctrl+key_b>key_n=text:\x02n
keybind = ctrl+key_b>key_o=text:\x02o
keybind = ctrl+key_b>key_p=text:\x02p
keybind = ctrl+key_b>key_q=text:\x02q
keybind = ctrl+key_b>key_r=text:\x02r
keybind = ctrl+key_b>key_s=text:\x02s
keybind = ctrl+key_b>key_t=text:\x02t
keybind = ctrl+key_b>key_u=text:\x02u
keybind = ctrl+key_b>key_v=text:\x02v
keybind = ctrl+key_b>key_w=text:\x02w
keybind = ctrl+key_b>key_x=text:\x02x
keybind = ctrl+key_b>key_y=text:\x02y
keybind = ctrl+key_b>key_z=text:\x02z
keybind = ctrl+key_b>shift+key_c=text:\x02C
keybind = ctrl+key_b>shift+key_d=text:\x02D
keybind = ctrl+key_b>shift+key_e=text:\x02E
keybind = ctrl+key_b>shift+key_i=text:\x02I
keybind = ctrl+key_b>shift+key_l=text:\x02L
keybind = ctrl+key_b>shift+key_m=text:\x02M
keybind = ctrl+key_b>shift+key_u=text:\x02U
keybind = ctrl+key_b>ctrl+key_b=text:\x02\x02
keybind = ctrl+key_b>ctrl+key_l=text:\x02\x0c
keybind = ctrl+key_b>ctrl+key_o=text:\x02\x0f
keybind = ctrl+key_b>ctrl+key_r=text:\x02\x12
keybind = ctrl+key_b>ctrl+key_s=text:\x02\x13
keybind = ctrl+key_b>ctrl+key_z=text:\x02\x1a

cursor-text = black

background = #000000
background-opacity = 0.75
background-blur = true

window-decoration = false

custom-shader-animation = true
custom-shader = shader/cursor_blaze.glsl
custom-shader = shader/cursor_smear.glsl
