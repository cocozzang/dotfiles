font-family = CaskaydiaCove Nerd Font
font-size = 16

theme = catppuccin-mocha.conf

gtk-titlebar = false
window-padding-x = 12
window-padding-y = 12

keybind = cmd+opt+h=goto_split:left
keybind = cmd+opt+j=goto_split:bottom
keybind = cmd+opt+k=goto_split:top
keybind = cmd+opt+l=goto_split:right

keybind = cmd+opt+v=new_split:right
keybind = cmd+opt+s=new_split:down

keybind = cmd+opt+shift+h=resize_split:left,50
keybind = cmd+opt+shift+j=resize_split:down,50
keybind = cmd+opt+shift+k=resize_split:up,50
keybind = cmd+opt+shift+l=resize_split:right,50

keybind = cmd+opt+x=close_surface

keybind = cmd+opt+z=toggle_split_zoom
keybind = shift+enter=text:\n

cursor-text = black

background = #000000
background-opacity = 0.75
background-blur = true

window-decoration = false

custom-shader-animation = true
custom-shader = shader/cursor_blaze.glsl
custom-shader = shader/cursor_smear.glsl

