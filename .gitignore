config/lazygit/state.yml
config/lazygit/.tmp
config/.config/go
config/.config/raycast
config/.config/fish/completions/grok.fish
config/.config/tmux/*
!config/.config/tmux/tmux.conf

.gnupg
.ssh
env-api-key.sh

.DS_Store

# ~/.claude — 설정 파일만 관리하고 런타임/캐시/로그는 전부 제외
# plugins/는 claude가 원자적 rename으로 덮어써서 stow 링크가 끊기므로 관리하지 않음
config/.claude/*
!config/.claude/settings.json
!config/.claude/keybindings.json
!config/.claude/statusline.sh
!config/.claude/statusline-simple.sh
